# LiveKit server WebSocket URL
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Token: use ONE of the two options below ---

# Option A: static token for quick testing (expires quickly — replace as needed)
# Generate one from your LiveKit dashboard or oussama-voice backend
# VITE_LIVEKIT_TOKEN=eyJ...

# Option B: token endpoint (recommended for production)
# Your oussama-voice backend exposes GET /token → { "accessToken": "eyJ..." }
# VITE_LIVEKIT_TOKEN_URL=https://your-oussama-voice.railway.app/token
